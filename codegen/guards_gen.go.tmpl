//go:generate go run ../../cmd/shenmux-gen -spec ../../specs/mux.shen -template ../../codegen/guards_gen.go.tmpl -out guards_gen.go

// Code generated by shenmux-gen from specs/mux.shen. DO NOT EDIT.
// Spec SHA-256: {{SPEC_SHA256}}
//
// Pure predicates and transitions below execute the embedded Shen model through
// internal/shenmodel. Host code supplies only opaque representations, boundary
// safety caps, and error mapping.

package shenguard

import (
	"errors"
	"fmt"
	"strings"
	"unicode/utf8"

	"github.com/pyrex41/shenmux/internal/shenmodel"
)

const (
	SpecSHA256       = "{{SPEC_SHA256}}"
	maxClientIDBytes = 128
	maxSnapshotBytes = 64 << 20
)

const generatedShenSource = {{SPEC_SOURCE}}

var semanticModel = shenmodel.MustParse(generatedShenSource)

var (
	ErrAlreadyAttached = errors.New("client already attached")
	ErrNotAttached     = errors.New("client is not attached")
	ErrWriterLocked    = errors.New("session writer is locked")
	ErrWriterUnlocked  = errors.New("session writer is not locked")
	ErrSequence        = errors.New("non-monotonic sequence")
	ErrExited          = errors.New("session has exited")
	ErrNoControl       = errors.New("client does not own control")
	ErrControlOwned    = errors.New("session control is owned by another client")
	ErrSnapshotMismatch = errors.New("snapshot does not match session boundary")
	ErrSnapshotOwnerMismatch = errors.New("snapshot client does not match pending attachment")
	ErrInvalidDimensions = errors.New("invalid dimensions")
	ErrUnknownCommand = errors.New("unknown Shen control command")
)

func SemanticSource() string { return generatedShenSource }

// callSemantic is the private generated bridge used by the typed reducer API.
func callSemantic(name string, args ...any) (any, error) {
	return semanticModel.Call(name, args...)
}

// ClientID corresponds to Shen datatype client-id.
type ClientID struct{ v string }

func NewClientID(v string) (ClientID, error) {
	if len(v) > maxClientIDBytes {
		return ClientID{}, fmt.Errorf("client-id exceeds %d bytes", maxClientIDBytes)
	}
	if !utf8.ValidString(v) {
		return ClientID{}, errors.New("client-id must be valid UTF-8")
	}
	if strings.IndexByte(v, 0) >= 0 {
		return ClientID{}, errors.New("client-id must not contain NUL")
	}
	if !mustBool("mux.valid-client-id?", v) {
		return ClientID{}, errors.New("client-id rejected by Shen model")
	}
	return ClientID{v: v}, nil
}

func (c ClientID) String() string { return c.v }
func (c ClientID) IsZero() bool   { return c.v == "" }

// SeqNo corresponds to Shen datatype seq-no.
type SeqNo struct{ n uint64 }

func NewSeqNo(n uint64) SeqNo  { return SeqNo{n: n} }
func (s SeqNo) Uint64() uint64 { return s.n }

func NextSeq(s SeqNo) (SeqNo, error) {
	value, err := semanticModel.Call("mux.next-seq", s.n)
	if err != nil {
		return SeqNo{}, err
	}
	n, ok := valueAsUint64(value)
	if !ok {
		return SeqNo{}, fmt.Errorf("mux.next-seq returned %T", value)
	}
	return SeqNo{n: n}, nil
}

// Clock corresponds to Shen datatype clock: what time the host says it is, and
// how long an unexercised control lease is still believed. Both are
// milliseconds on a monotonic host reading; the model never reads a clock.
type Clock struct{ now, lease uint64 }

func NewClock(now, lease uint64) (Clock, error) {
	if !mustBool("mux.valid-clock?", now, lease) {
		return Clock{}, errors.New("clock rejected by Shen model")
	}
	return Clock{now: now, lease: lease}, nil
}

func (c Clock) Now() uint64   { return c.now }
func (c Clock) Lease() uint64 { return c.lease }

func clockValue(c Clock) shenmodel.List { return shenmodel.List{c.now, c.lease} }

// DeliveryFatal reports whether a failure to deliver to one named client ends
// the session for everyone. The answer lives in the Shen model so that adding a
// new transport outcome cannot quietly change it: an outcome the host does not
// recognise is per-peer, because it was learned at a send addressed to a peer.
func DeliveryFatal(outcome string) bool { return mustBool("mux.delivery-fatal?", outcome) }

// Dimensions corresponds to Shen datatype dimensions.
type Dimensions struct{ cols, rows uint16 }

func NewDimensions(cols, rows int) (Dimensions, error) {
	// The host bounds are representational; positivity belongs to Shen.
	if cols < 0 || cols > 65535 {
		return Dimensions{}, fmt.Errorf("columns outside host uint16 bounds: %d", cols)
	}
	if rows < 0 || rows > 65535 {
		return Dimensions{}, fmt.Errorf("rows outside host uint16 bounds: %d", rows)
	}
	if !mustBool("mux.valid-dimensions?", cols, rows) {
		return Dimensions{}, fmt.Errorf("dimensions %dx%d rejected by Shen model", cols, rows)
	}
	return Dimensions{cols: uint16(cols), rows: uint16(rows)}, nil
}

func (d Dimensions) Cols() uint16 { return d.cols }
func (d Dimensions) Rows() uint16 { return d.rows }
func (d Dimensions) IsZero() bool { return d.cols == 0 || d.rows == 0 }

// Snapshot is the Shen-constrained envelope around a canonical state archive.
type Snapshot struct {
	seq       SeqNo
	dim       Dimensions
	cursorX   uint16
	cursorY   uint16
	altScreen bool
	payload   []byte
}

func NewSnapshot(seq SeqNo, dim Dimensions, cursorX, cursorY int, altScreen bool, payload []byte) (Snapshot, error) {
	if cursorX < 0 || cursorX > 65535 || cursorY < 0 || cursorY > 65535 {
		return Snapshot{}, errors.New("snapshot cursor is outside host uint16 bounds")
	}
	if !mustBool("mux.valid-snapshot-meta?", seq.n, uint64(dim.cols), uint64(dim.rows), cursorX, cursorY) {
		return Snapshot{}, errors.New("snapshot metadata rejected by Shen model")
	}
	if len(payload) > maxSnapshotBytes {
		return Snapshot{}, fmt.Errorf("snapshot exceeds %d bytes", maxSnapshotBytes)
	}
	return Snapshot{seq: seq, dim: dim, cursorX: uint16(cursorX), cursorY: uint16(cursorY), altScreen: altScreen, payload: append([]byte(nil), payload...)}, nil
}

func (s Snapshot) Seq() SeqNo           { return s.seq }
func (s Snapshot) Dim() Dimensions      { return s.dim }
func (s Snapshot) CursorX() uint16      { return s.cursorX }
func (s Snapshot) CursorY() uint16      { return s.cursorY }
func (s Snapshot) AltScreen() bool      { return s.altScreen }
func (s Snapshot) Payload() []byte      { return append([]byte(nil), s.payload...) }

// Session is opaque outside this package. Every pure transition is evaluated
// by the embedded Shen source.
type Session struct {
	clients      []ClientID
	lastSeq      SeqNo
	lastSnap     Snapshot
	dim          Dimensions
	writerLocked bool
	exited       bool
	controller   ClientID
	pendingAttach ClientID
	// heard is when the control owner last exercised control, not when it was
	// last heard from. See specs/mux.shen.
	heard uint64
}

func NewSession(dim Dimensions) (Session, error) {
	if dim.IsZero() {
		return Session{}, errors.New("session dimensions are invalid")
	}
	initial, err := NewSnapshot(NewSeqNo(0), dim, 0, 0, false, nil)
	if err != nil {
		return Session{}, err
	}
	return Session{lastSnap: initial, dim: dim}, nil
}

func (s Session) Clients() []ClientID       { return append([]ClientID(nil), s.clients...) }
func (s Session) LastSeq() SeqNo            { return s.lastSeq }
func (s Session) LastSnapshot() Snapshot    { return s.lastSnap }
func (s Session) Dim() Dimensions           { return s.dim }
func (s Session) WriterLocked() bool         { return s.writerLocked }
func (s Session) Exited() bool               { return s.exited }
func (s Session) ControlOwner() (ClientID, bool) { return s.controller, !s.controller.IsZero() }
func (s Session) PendingAttach() (ClientID, bool) { return s.pendingAttach, !s.pendingAttach.IsZero() }

// Heard is the instant at which the control owner last exercised control. It is
// deliberately not a liveness signal and there is no accessor that reports one.
func (s Session) Heard() uint64 { return s.heard }

// OwnerFresh reports whether the recorded owner's claim is still inside the
// lease window at this clock. A stale claim does not exclude a competing one.
func OwnerFresh(s Session, clock Clock) bool {
	return mustBool("mux.owner-fresh?", clockValue(clock), s.heard)
}

func IsAttached(s Session, cid ClientID) bool {
	return mustBool("mux.member?", cid.String(), clientListValue(s.clients))
}

func AttachOK(s Session, cid ClientID) bool {
	return !cid.IsZero() && mustBool("mux.attach-ok?", sessionValue(s), cid.String())
}

func HasControl(s Session, cid ClientID) bool {
	return !cid.IsZero() && mustBool("mux.has-control?", sessionValue(s), cid.String())
}

func AcceptInput(s Session, cid ClientID) bool {
	return !cid.IsZero() && mustBool("mux.accept-input?", sessionValue(s), cid.String())
}

func AcceptResize(s Session, cid ClientID) bool {
	return !cid.IsZero() && mustBool("mux.accept-resize?", sessionValue(s), cid.String())
}

func AcquireControlOK(s Session, clock Clock, cid ClientID) bool {
	return !cid.IsZero() && mustBool("mux.acquire-control-ok?", sessionValue(s), clockValue(clock), cid.String())
}

func ReleaseControlOK(s Session, cid ClientID) bool {
	return !cid.IsZero() && mustBool("mux.release-control-ok?", sessionValue(s), cid.String())
}

func BeginSnapshot(s Session) (Session, error) {
	if s.writerLocked {
		return Session{}, ErrWriterLocked
	}
	return callSession("mux.begin-snapshot", sessionValue(s))
}

func EndSnapshot(s Session, snap Snapshot) (Session, error) {
	if !s.writerLocked {
		return Session{}, ErrWriterUnlocked
	}
	if snap.seq != s.lastSeq {
		return Session{}, fmt.Errorf("snapshot seq %d does not match session seq %d: %w", snap.seq.n, s.lastSeq.n, ErrSequence)
	}
	if snap.dim != s.dim {
		return Session{}, errors.New("snapshot dimensions do not match session")
	}
	return callSession("mux.end-snapshot", sessionValue(s), snapshotValue(snap))
}

func Attach(s Session, cid ClientID) (Session, error) {
	if IsAttached(s, cid) {
		return Session{}, ErrAlreadyAttached
	}
	if s.writerLocked {
		return Session{}, ErrWriterLocked
	}
	if cid.IsZero() {
		return Session{}, errors.New("zero client-id")
	}
	if !AttachOK(s, cid) {
		return Session{}, errors.New("attach rejected by Shen model")
	}
	return callSession("mux.attach", sessionValue(s), cid.String())
}

func Detach(s Session, cid ClientID) (Session, error) {
	if !IsAttached(s, cid) {
		return Session{}, ErrNotAttached
	}
	return callSession("mux.detach", sessionValue(s), cid.String())
}

func AcquireControl(s Session, clock Clock, cid ClientID) (Session, error) {
	if !IsAttached(s, cid) {
		return Session{}, ErrNotAttached
	}
	if s.exited {
		return Session{}, ErrExited
	}
	// A recorded owner only excludes a competing claim while its claim is fresh;
	// the model owns that judgement, so ask it rather than comparing here.
	if owner, ok := s.ControlOwner(); ok && owner != cid && OwnerFresh(s, clock) {
		return Session{}, ErrControlOwned
	}
	if !AcquireControlOK(s, clock, cid) {
		return Session{}, errors.New("control acquisition rejected by Shen model")
	}
	return callSession("mux.acquire-control", sessionValue(s), clockValue(clock), cid.String())
}

func ReleaseControl(s Session, cid ClientID) (Session, error) {
	if !ReleaseControlOK(s, cid) {
		return Session{}, ErrNoControl
	}
	return callSession("mux.release-control", sessionValue(s), cid.String())
}

func ApplyDelta(s Session, seq SeqNo) (Session, error) {
	if err := eventAllowed(s, seq); err != nil {
		return Session{}, err
	}
	return callSession("mux.apply-delta", sessionValue(s), seq.n)
}

func ApplyResize(s Session, seq SeqNo, dim Dimensions) (Session, error) {
	if dim.IsZero() {
		return Session{}, errors.New("event dimensions are invalid")
	}
	if err := eventAllowed(s, seq); err != nil {
		return Session{}, err
	}
	return callSession("mux.apply-resize", sessionValue(s), seq.n, dimensionValue(dim))
}

func ApplyControl(s Session, seq SeqNo) (Session, error) {
	if err := eventAllowed(s, seq); err != nil {
		return Session{}, err
	}
	return callSession("mux.apply-control", sessionValue(s), seq.n)
}

func ApplyExit(s Session, seq SeqNo) (Session, error) {
	if err := eventAllowed(s, seq); err != nil {
		return Session{}, err
	}
	return callSession("mux.apply-exit", sessionValue(s), seq.n)
}

// ApplyEvent is retained as a small compatibility dispatcher.
func ApplyEvent(s Session, seq SeqNo, dim *Dimensions, exit bool) (Session, error) {
	if exit {
		return ApplyExit(s, seq)
	}
	if dim != nil {
		return ApplyResize(s, seq, *dim)
	}
	return ApplyDelta(s, seq)
}

func eventAllowed(s Session, seq SeqNo) error {
	if s.writerLocked {
		return ErrWriterLocked
	}
	if !mustBool("mux.event-ok?", sessionValue(s), seq.n) {
		expected, err := NextSeq(s.lastSeq)
		if err != nil {
			return err
		}
		return fmt.Errorf("got seq %d, expected %d: %w", seq.n, expected.n, ErrSequence)
	}
	return nil
}

func mustBool(name string, args ...any) bool {
	value, err := semanticModel.Call(name, args...)
	if err != nil {
		panic(fmt.Sprintf("generated Shen semantic call %s failed: %v", name, err))
	}
	boolean, ok := value.(bool)
	if !ok {
		panic(fmt.Sprintf("generated Shen semantic call %s returned %T", name, value))
	}
	return boolean
}

func callSession(name string, args ...any) (Session, error) {
	value, err := semanticModel.Call(name, args...)
	if err != nil {
		return Session{}, err
	}
	return sessionFromValue(value)
}

func sessionValue(s Session) shenmodel.List {
	controller := shenmodel.List{}
	if !s.controller.IsZero() {
		controller = shenmodel.List{s.controller.String()}
	}
	pending := shenmodel.List{}
	if s.writerLocked && !s.pendingAttach.IsZero() {
		pending = shenmodel.List{s.pendingAttach.String()}
	}
	control := shenmodel.List{controller, pending}
	return shenmodel.List{
		clientListValue(s.clients), s.lastSeq.n, snapshotValue(s.lastSnap), dimensionValue(s.dim),
		s.writerLocked, s.exited, control, s.heard,
	}
}

func clientListValue(clients []ClientID) shenmodel.List {
	out := make(shenmodel.List, len(clients))
	for i, client := range clients {
		out[i] = client.String()
	}
	return out
}

func dimensionValue(dim Dimensions) shenmodel.List {
	return shenmodel.List{uint64(dim.cols), uint64(dim.rows)}
}

// snapshotValue deliberately exposes only the Shen snapshot envelope. Payload
// bytes remain opaque to Shen and are carried as a string solely so the model
// can preserve the value through a pure transition.
func snapshotValue(snapshot Snapshot) shenmodel.List {
	return shenmodel.List{
		snapshot.seq.n,
		dimensionValue(snapshot.dim),
		uint64(snapshot.cursorX), uint64(snapshot.cursorY), snapshot.altScreen,
		string(snapshot.payload),
	}
}

func sessionFromValue(value any) (Session, error) {
	list, ok := value.(shenmodel.List)
	if !ok || len(list) != 8 {
		return Session{}, fmt.Errorf("Shen session transition returned %T with invalid shape", value)
	}
	clientValues, ok := list[0].(shenmodel.List)
	if !ok {
		return Session{}, fmt.Errorf("Shen session clients have type %T", list[0])
	}
	clients := make([]ClientID, len(clientValues))
	seen := make(map[string]struct{}, len(clientValues))
	for i, raw := range clientValues {
		text, ok := raw.(string)
		if !ok {
			return Session{}, fmt.Errorf("Shen client %d has type %T", i, raw)
		}
		client, err := NewClientID(text)
		if err != nil {
			return Session{}, err
		}
		if _, duplicate := seen[text]; duplicate {
			return Session{}, fmt.Errorf("Shen session contains duplicate client %q", text)
		}
		seen[text] = struct{}{}
		clients[i] = client
	}
	seq, ok := valueAsUint64(list[1])
	if !ok {
		return Session{}, fmt.Errorf("Shen session sequence has type %T", list[1])
	}
	snapshot, err := snapshotFromValue(list[2])
	if err != nil { return Session{}, err }
	dim, err := dimensionFromValue(list[3])
	if err != nil {
		return Session{}, err
	}
	locked, ok := list[4].(bool)
	if !ok {
		return Session{}, fmt.Errorf("Shen session lock has type %T", list[4])
	}
	exited, ok := list[5].(bool)
	if !ok {
		return Session{}, fmt.Errorf("Shen session exited flag has type %T", list[5])
	}
	control, ok := list[6].(shenmodel.List)
	if !ok || len(control) != 2 {
		return Session{}, errors.New("Shen session control has invalid shape")
	}
	heard, ok := valueAsUint64(list[7])
	if !ok {
		return Session{}, fmt.Errorf("Shen session heard-at has type %T", list[7])
	}
	var controller ClientID
	var pending ClientID
	controllerValues, ok := control[0].(shenmodel.List)
	if !ok || len(controllerValues) > 1 { return Session{}, errors.New("Shen controller has invalid shape") }
	pendingValues, ok := control[1].(shenmodel.List)
	if !ok || len(pendingValues) > 1 { return Session{}, errors.New("Shen pending attach has invalid shape") }
	if len(controllerValues) == 1 {
		text, ok := controllerValues[0].(string)
		if !ok {
			return Session{}, fmt.Errorf("Shen controller has type %T", controllerValues[0])
		}
		controller, err = NewClientID(text)
		if err != nil { return Session{}, err }
		if _, attached := seen[text]; !attached { return Session{}, fmt.Errorf("Shen controller %q is not attached", text) }
	}
	if len(pendingValues) == 1 {
		if !locked { return Session{}, errors.New("Shen pending attach exists while writer is unlocked") }
		text, ok := pendingValues[0].(string)
		if !ok { return Session{}, fmt.Errorf("Shen pending attach has type %T", pendingValues[0]) }
		pending, err = NewClientID(text)
		if err != nil { return Session{}, err }
	}
	// Ownership evidence without an owner is a state the model never produces
	// and the host must never be able to fabricate: it would make a later
	// acquisition inherit a stranger's freshness.
	if len(controllerValues) == 0 && heard != 0 {
		return Session{}, errors.New("Shen session records control evidence with no owner")
	}
	return Session{clients: clients, lastSeq: SeqNo{n: seq}, lastSnap: snapshot, dim: dim, writerLocked: locked, exited: exited, controller: controller, pendingAttach: pending, heard: heard}, nil
}

func snapshotFromValue(value any) (Snapshot, error) {
	list, ok := value.(shenmodel.List)
	if !ok || len(list) != 6 { return Snapshot{}, fmt.Errorf("Shen snapshot has type/shape %T", value) }
	seq, ok := valueAsUint64(list[0]); if !ok { return Snapshot{}, fmt.Errorf("Shen snapshot sequence has type %T", list[0]) }
	dim, err := dimensionFromValue(list[1]); if err != nil { return Snapshot{}, err }
	cursorX, okX := valueAsUint64(list[2]); cursorY, okY := valueAsUint64(list[3])
	if !okX || !okY || cursorX > 65535 || cursorY > 65535 { return Snapshot{}, errors.New("Shen snapshot cursor is outside host bounds") }
	alt, ok := list[4].(bool); if !ok { return Snapshot{}, fmt.Errorf("Shen snapshot alt-screen has type %T", list[4]) }
	payload, ok := list[5].(string); if !ok { return Snapshot{}, fmt.Errorf("Shen snapshot payload has type %T", list[5]) }
	return NewSnapshot(NewSeqNo(seq), dim, int(cursorX), int(cursorY), alt, []byte(payload))
}

func dimensionFromValue(value any) (Dimensions, error) {
	list, ok := value.(shenmodel.List)
	if !ok || len(list) != 2 {
		return Dimensions{}, fmt.Errorf("Shen dimensions have type/shape %T", value)
	}
	cols, okCols := valueAsUint64(list[0])
	rows, okRows := valueAsUint64(list[1])
	if !okCols || !okRows || cols > 65535 || rows > 65535 {
		return Dimensions{}, errors.New("Shen dimensions are outside host bounds")
	}
	return NewDimensions(int(cols), int(rows))
}

func valueAsUint64(value any) (uint64, bool) {
	switch n := value.(type) {
	case uint64:
		return n, true
	case uint32:
		return uint64(n), true
	case uint16:
		return uint64(n), true
	case int:
		if n >= 0 { return uint64(n), true }
	}
	return 0, false
}
