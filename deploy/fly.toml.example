app = "replace-me"
primary_region = "ord"

[build]
  image = "ghcr.io/pyrex41/shenmux:latest"

[mounts]
  source = "shenmux_state"
  destination = "/var/lib/shenmux"

[processes]
  agent = "shenmux agent --controller https://controller.example"

# The agent is egress-only. Do not add an http_service or expose muxd's
# ZeroMQ ports. Store the enrollment code as a one-time Fly secret.
