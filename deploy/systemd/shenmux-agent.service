[Unit]
Description=shenmux outbound agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shenmux
Group=shenmux
StateDirectory=shenmux
ExecStart=/usr/local/bin/shenmux agent --controller ${SHENMUX_CONTROLLER}
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/shenmux

[Install]
WantedBy=multi-user.target
