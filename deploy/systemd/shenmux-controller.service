[Unit]
Description=shenmux self-hosted controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shenmux
Group=shenmux
StateDirectory=shenmux-controller
ExecStart=/usr/local/bin/shenmux controller --listen 0.0.0.0:8788 --state-dir /var/lib/shenmux-controller
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shenmux-controller

[Install]
WantedBy=multi-user.target
