diff --git a/options.go b/options.go
index dc0394e..cd54c32 100644
--- a/options.go
+++ b/options.go
@@ -26,6 +26,10 @@ const defaultHandshakeTimeout = 5 * time.Second
 
 // socketConfig holds per-socket configuration built from Option functions.
 type socketConfig struct {
+	// maxFrameBodySize caps the body of a post-handshake frame, i.e. the
+	// largest allocation a peer can force. Zero uses the wire default.
+	maxFrameBodySize int64
+
 	// clientMechFactory builds a fresh ClientMechanism for Connect paths.
 	clientMechFactory func(socketType string) (security.ClientMechanism, error)
 	// serverMechFactory builds a fresh Mechanism for Bind/Accept paths.
@@ -255,3 +259,17 @@ func WithZAPDomain(r *zmqzap.Router, domain string) Option {
 func WithMonitor(ch chan<- SocketEvent) Option {
 	return func(cfg *socketConfig) { cfg.monitorCh = ch }
 }
+
+// WithMaxFrameBodySize caps the body of post-handshake frames, bounding the
+// largest allocation a peer can force on this socket. Zero or unset keeps the
+// wire default. Panics if n is negative.
+//
+// Without this, a socket-level message-size limit can only be applied after the
+// frame has been read in full, so it bounds what a socket keeps rather than
+// what a peer can make it allocate.
+func WithMaxFrameBodySize(n int64) Option {
+	if n < 0 {
+		panic("zmq4: WithMaxFrameBodySize: n must not be negative")
+	}
+	return func(c *socketConfig) { c.maxFrameBodySize = n }
+}
