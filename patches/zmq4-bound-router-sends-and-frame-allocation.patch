 package zmq4
 
 import (
+	"context"
 	"crypto/rand"
 	"sync"
 
@@ -105,9 +106,14 @@ func (p *pipe) writeLoop(closeCh <-chan struct{}) {
 }
 
 // send enqueues msg for delivery according to the pipe's overflow policy.
-// Returns true if the message was queued, false if the socket is closing (Block)
-// or the queue is full (Drop).
-func (p *pipe) send(msg Message, closeCh <-chan struct{}) bool {
+// Returns true if the message was queued, false if the socket is closing
+// (Block), the queue is full (Drop), or ctx was cancelled while waiting.
+//
+// Under Block, waiting on ctx as well as closeCh is what keeps one peer that
+// has stopped draining from wedging the socket for everybody: without it the
+// only way out is closing the whole socket, so a caller who passed a context
+// with a deadline would still block forever.
+func (p *pipe) send(ctx context.Context, msg Message, closeCh <-chan struct{}) bool {
 	switch p.overflow {
 	case Drop:
 		select {
@@ -122,6 +128,8 @@ func (p *pipe) send(msg Message, closeCh <-chan struct{}) bool {
 			return true
 		case <-closeCh:
 			return false
+		case <-ctx.Done():
+			return false
 		}
 	}
 }
