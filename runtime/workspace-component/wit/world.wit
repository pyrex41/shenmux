package shenmux:workspace@0.2.0;

interface filesystem {
  record entry {
    name: string,
    kind: string,
    size: u64,
  }

  variant error {
    not-found,
    permission-denied,
    conflict,
    io(string),
  }

  list-entries: func(path: string) -> result<list<entry>, error>;
  read: func(path: string, offset: u64, length: u64) -> result<list<u8>, error>;
  write: func(path: string, data: list<u8>, truncate: bool) -> result<_, error>;
  mkdir: func(path: string) -> result<_, error>;
}

interface runtime {
  use filesystem.{entry};

  record response {
    cwd: string,
    output: string,
    error: option<string>,
    entries: list<entry>,
  }

  // Run one deterministic workspace command against the host filesystem.
  // The host owns persistence, caching, and synchronization; the component
  // owns command semantics and never sees browser or object-store APIs.
  run: func(cwd: string, command: string) -> response;
}

world workspace {
  import filesystem;
  export runtime;
}
